# Copy this file's variable names into your Vercel project's Environment
# Variables settings (Project -> Settings -> Environment Variables).
# Never commit a real .env file with actual values.

# Neon Postgres connection string (added automatically if you connect Neon
# via the Vercel Marketplace integration - otherwise copy it from your Neon
# project's dashboard and add it here under this exact name).
DATABASE_URL=

# Admin panel login (/admin).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
