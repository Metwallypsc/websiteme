# Copy this file's variable names into your Vercel project's Environment
# Variables settings (Project -> Settings -> Environment Variables).
# Never commit a real .env file with actual values.

# Neon Postgres connection string (added automatically if you connect Neon
# via the Vercel Marketplace integration - otherwise copy it from your Neon
# project's dashboard and add it here under this exact name).
DATABASE_URL=

# Admin panel login (/admin).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Book a Call + Contact Form ---

# Public Calendly scheduling link. Exposed to the browser (VITE_ prefix),
# so this is not secret - just the URL people book calls at.
VITE_CALENDLY_URL=https://calendly.com/your-handle/30min

# Resend (resend.com) - sends the contact form's notification email.
# Free tier is enough for a personal site's contact form volume.
RESEND_API_KEY=

# Optional: only needed once you verify a domain with Resend. Until then,
# emails send from Resend's shared onboarding@resend.dev sender, which
# works with zero setup but has weaker deliverability/branding.
RESEND_FROM_EMAIL=

# Cloudflare Turnstile (challenges.cloudflare.com) - spam protection on the
# contact form. Site key is public (VITE_ prefix); secret key stays
# server-side and is used to verify submissions in api/contact.ts.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
